# Supabase 配置
# 請將下面的值替換為您的實際 Supabase 專案資訊

# 您的 Supabase Project URL
# 格式：https://xxxxxxxxxxxx.supabase.co
# 從 Supabase Dashboard > Settings > API 複製
VITE_SUPABASE_URL=https://lmsrbqjnssbuexcubypq.supabase.co

# 您的 Supabase Anon Key (public)
# 從 Supabase Dashboard > Settings > API 複製
# 這是一個很長的 JWT token，以 eyJ... 開頭
VITE_SUPABASE_ANON_KEY=請將您的_anon_key_貼在這裡
